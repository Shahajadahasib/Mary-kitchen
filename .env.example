# Copy to `.env` to run the stack on a developer machine:
#
#     cp .env.example .env
#     docker compose up --build
#
# Docker Compose reads this file itself, to fill in the ${VAR:-default}
# substitutions in docker-compose.yml. The defaults in that file are the
# production values, so the VPS needs no `.env` at all — which is just as well,
# since `.env` is gitignored and never gets deployed.
#
# This is NOT Django's settings file. That one is backend/.env (copied from
# backend/.env.example) and is passed into the backend container via `env_file`.

# Development settings: DEBUG=True, so Django serves /media/ and /static/
# itself, Celery tasks run eagerly, and email prints to the container log.
DJANGO_SETTINGS_MODULE=mary_kitchen.settings.development

# /var/www/Mary-kitchen/media is a path on the VPS; locally use a named volume.
MEDIA_VOLUME=media_data

# Must be reachable from your BROWSER — `backend` is a Compose service name that
# only resolves between containers.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# All published ports bind to this host address. The default (loopback) is what
# production wants — Nginx proxies to 127.0.0.1 and nothing else should reach
# Postgres, Redis, Gunicorn or Next.js directly. Set it to 0.0.0.0 only if you
# need to hit the stack from another machine on your LAN, and never on the VPS:
# Docker's port rules sit in front of ufw, so a 0.0.0.0 binding is reachable
# from the internet even when the firewall says otherwise.
# BIND_HOST=127.0.0.1
